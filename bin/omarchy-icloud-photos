#!/usr/bin/env bash
# Launch the omarchy-icloud-photos viewer. Quickshell runs the QML next to this script,
# so the app works from wherever the repository is checked out.
set -euo pipefail
dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# --demo: a stand-in library built from the Omarchy theme backgrounds, kept
# apart from the real config and cache. Good for screenshots.
if [ "${1:-}" = "--demo" ]; then
  shift
  "$dir/bin/omarchy-icloud-photos-demo" >&2
  eval "export $("$dir/bin/omarchy-icloud-photos-demo" --print-env)"
  # --tour: scroll through the grid by itself, for recording.
  if [ "${1:-}" = "--tour" ]; then
    shift
    export OMARCHY_ICLOUD_PHOTOS_TOUR=1
  fi
fi

# Re-export the selected account before the window opens. This is local-only
# and prevents a cached index from another account appearing on startup.
config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-icloud-photos/config"
if [ "${DEMO:-0}" != 1 ] && [ -f "$config" ] && ! grep -Eq '^DEMO=1[[:space:]]*$' "$config" && grep -q '^APPLE_ID=' "$config"; then
  "$dir/bin/omarchy-icloud-photos-catalog" export
fi
exec quickshell -p "$dir/ui/shell.qml" "$@"
